*.local.json

# Modo local de desarrollo: js/dev.local.js arranca la app en localhost sin
# sesión de Supabase, con datos de prueba, para poder verificar pantallas sin
# escribir ninguna contraseña. Nunca se despliega ni se comparte.
*.local.js

.DS_Store
Thumbs.db

# El material con que arrancó el journal (mayo 2026: chat, CSV/XLSX, PDFs): archivado
# en disco, nunca en el repositorio (docs/disenos/2026-09-29-orden-raiz.md)
docs/archivo/inicio-journal/

# Windows: el icono de la carpeta (desktop.ini lleva la ruta E:\ y TJ.ico solo lo usa él)
desktop.ini
icons/TJ.ico

# Caché local de wrangler (se regenera solo)
.wrangler/

# --- chaumer/ ---------------------------------------------------------------
# Las reglas que valen a cualquier profundidad van como chaumer/**/…

# trabajo interno cerrado: se conserva en disco, no en el repositorio
# (hoy, claude/motor/_Historia)
chaumer/**/_Historia/

# material de terceros archivado (transcripciones de Chaumer, capturas): en disco,
# nunca en el repositorio, que es publico (D-022, D-030)
docs/archivo/chaumer/materia-prima/

# datos de mercado exportados de NinjaTrader
chaumer/05_Backtesting/claude/motor/datos/

# graficos del backtesting manual (el de Kris): se quedan en disco (decision del
# 22/09/2026; crecen cada dia y en git quedarian para siempre en el historial).
# Las Sesiones de claude/ SI van a git: el portal se publica desde ahi.
chaumer/05_Backtesting/kris/*.png

# portal: lo que genera la compilacion
chaumer/04_Web/node_modules/
chaumer/04_Web/dist/
chaumer/04_Web/.astro/
chaumer/04_Web/src/content/
chaumer/04_Web/public/assets/
chaumer/04_Web/public/min/
chaumer/04_Web/public/_detector.js

# Cloudflare en local: .dev.vars lleva CLAVE_OPERADOR para probar en el equipo;
# .wrangler/ es la base y el almacen simulados
chaumer/04_Web/.dev.vars
chaumer/04_Web/.wrangler/

# general
chaumer/**/node_modules/
chaumer/**/dist/
chaumer/**/.env
chaumer/**/.env.*
!chaumer/**/.env.example
chaumer/**/*.tmp
chaumer/**/__pycache__/
chaumer/**/*.pyc

# skills de terceros e informes de auditoria de diseno: se regeneran
chaumer/.claude/skills/
chaumer/**/.agents/
chaumer/**/.agent/
chaumer/**/skills-lock.json
chaumer/**/.impeccable/

# Salida del sincronizador del plan: se guarda como migración, no suelta
scripts/plan/salida.sql
scripts/plan/salida-documentos.sql

# Python fuera de chaumer/ (scripts/cadena)
__pycache__/
