# --- material de terceros y archivos grandes: NUNCA al repositorio ---
# PDFs de Chaumer y ~1,4 GB de video de sus sesiones.
# Aparte del tema de derechos, GitHub rechaza archivos de más de 100 MB.
00_Guias/

# --- trabajo interno ---
# _Historia/ guarda lo cerrado: historiales, prompts caducados y cuadernos
# de trabajo. Se conserva en disco, no en el repositorio.
_Historia/
03_Materia_Prima/transcripciones/

# --- datos de mercado exportados de NinjaTrader ---
05_Backtesting/datos/

# --- graficos del backtesting manual: se quedan en disco ---
# Decision del operador, 22/09/2026. Son 33 MB de PNG solo en 2025 y
# crecen cada dia; en git quedarian para siempre en el historial. La
# bitacora del portal guarda sus imagenes aparte, en Cloudflare R2.
05_Backtesting/05_01_Operativo/Back_*/

# --- módulo web (fase 2) ---
04_Web/node_modules/
04_Web/dist/
04_Web/.astro/
04_Web/src/content/
04_Web/public/assets/
04_Web/public/min/

# --- general ---
node_modules/
dist/
.env
.env.*
*.tmp
desktop.ini
Thumbs.db
__pycache__/
*.pyc

# el ejemplo SI va al repositorio: documenta los nombres, nunca los valores
!.env.example

# auditor temporal, no se versiona
04_Web/public/_detector.js

# skills de terceros: se reinstalan con su CLI, no se versionan
.claude/skills/
.agents/
.agent/
skills-lock.json

# Los diagramas dibujados SI se guardan: dibujarlos necesita un navegador sin
# ventana, y la publicacion automatica de GitHub no deberia depender de eso.
# Se regeneran solos en local cuando cambia el mermaid de origen.

# informes de auditoria de diseno: se regeneran ejecutando la revision
.impeccable/

# imagenes que caen en textos/ al corregir contenido: se copian a public/
# con su nombre y quedan fuera de git; textos/ es texto, no assets
04_Web/textos/*.jfif
04_Web/textos/*.jpg
04_Web/textos/*.jpeg
04_Web/textos/*.png

# --- Cloudflare en local ---
# .dev.vars lleva CLAVE_OPERADOR para probar en el equipo; el secreto de
# verdad se pone con `wrangler pages secret put`. .wrangler/ es la base y el
# almacen simulados en local.
04_Web/.dev.vars
04_Web/.wrangler/
