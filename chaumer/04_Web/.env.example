# Nombres de las variables. SIN VALORES: este archivo si va al repositorio.
# Los valores reales se ponen como secretos en Cloudflare (wrangler secret put),
# nunca en un archivo del proyecto y nunca en el paquete que descarga el navegador.

# --- Supabase: solo lo conoce el servidor de Cloudflare, jamas el cliente ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Quien es el operador: distingue revisor de operador al validar Access ---
# El correo se compara contra el que verifica Cloudflare Access, no contra
# nada que mande el navegador.
CORREO_OPERADOR=
