---
/**
 * Modulo 1 — Premercado.
 *
 * Todo lo que se decide antes de que abra el mercado americano. El orden no
 * es casual: primero el estado del operador (si falla, el dia se cierra ahi),
 * despues el calendario, despues la plataforma y solo al final el grafico.
 *
 * Las cifras salen de PARAMETROS.md, con DOS excepciones que el plan no
 * parametriza: lo que vale un punto ($2,00) y lo que vale un tick ($0,50).
 * No estan en PARAMETROS.md, asi que aqui van escritas. No se inventan
 * dividiendo el tope de stop: si hacen falta, se piden al plan.
 *
 * OJO (08/09/2026): hasta hoy esta pagina pedia UMBRAL_VOL_MNQ y
 * UMBRAL_VOL_NQ, que NO EXISTEN. El parametro real es UMBRAL_VOL, uno solo.
 * Al no encontrarlos, el atajo `v` caia en su texto de reserva y la pagina
 * pintaba los numeros a mano —incluido el umbral del NQ, retirado del plan
 * el 06/09/2026— sin que nadie se enterase. Por eso aqui ya no hay reservas:
 * si el parametro falta, que se note.
 */
import Modulo from '../componentes/Modulo.astro';
import { seccionesDe } from '../contenido/plan/indice.mjs';
import Estado from '../contenido/plan/premercado/estado.astro';
import Noticias from '../contenido/plan/premercado/noticias.astro';
import Instrumento from '../contenido/plan/premercado/instrumento.astro';
import Atm from '../contenido/plan/premercado/atm.astro';
import ZonasVol from '../contenido/plan/premercado/zonas-vol.astro';

// Los apartados viven en src/contenido/plan/premercado/ desde el 20/10/2026: los
// comparten esta página y «Reglas» (/plan). Su orden y su nombre corto, en indice.mjs.
const SECCIONES = seccionesDe('premercado');
---

<Modulo slug="premercado" secciones={SECCIONES}>
  <Estado />
  <Noticias />
  <Instrumento />
  <Atm />
  <ZonasVol />
</Modulo>
