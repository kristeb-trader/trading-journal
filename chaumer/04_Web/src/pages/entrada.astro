---
/**
 * Modulo 5 — Mecanica de entrada.
 *
 * Que orden, donde exactamente, y como se miden el stop y el objetivo. Lo que
 * IMPIDE entrar no esta aqui: esta en el modulo siguiente, y se comprueba
 * entre medir y enviar.
 */
import Modulo from '../componentes/Modulo.astro';
import { seccionesDe } from '../contenido/plan/indice.mjs';
import Orden from '../contenido/plan/entrada/orden.astro';
import Medir from '../contenido/plan/entrada/medir.astro';
import Antes from '../contenido/plan/entrada/antes.astro';
import Espera from '../contenido/plan/entrada/espera.astro';

// Los apartados viven en src/contenido/plan/entrada/ desde el 20/10/2026: los
// comparten esta página y «Reglas» (/plan). Su orden y su nombre corto, en indice.mjs.
const SECCIONES = seccionesDe('entrada');
---

<Modulo slug="entrada" secciones={SECCIONES}>
  <Orden />
  <Medir />
  <Antes />
  <Espera />
</Modulo>
