---
/**
 * Modulo 6 — Filtros: cuando NO se entra.
 *
 * Todo lo que frena una operacion, en el orden en que aparece: lo que impide
 * abrir el dia, lo que descarta un setup ya medido, y lo que mata una orden
 * que ya estaba puesta.
 */
import Modulo from '../componentes/Modulo.astro';
import { seccionesDe } from '../contenido/plan/indice.mjs';
import Dia from '../contenido/plan/filtros/dia.astro';
import Cuatro from '../contenido/plan/filtros/cuatro.astro';
import Noticias from '../contenido/plan/filtros/noticias.astro';
import Cancelan from '../contenido/plan/filtros/cancelan.astro';
import Despues from '../contenido/plan/filtros/despues.astro';

// Los apartados viven en src/contenido/plan/filtros/ desde el 20/10/2026: los
// comparten esta página y «Reglas» (/plan). Su orden y su nombre corto, en indice.mjs.
const SECCIONES = seccionesDe('filtros');
---

<Modulo slug="filtros" secciones={SECCIONES}>
  <Dia />
  <Cuatro />
  <Noticias />
  <Cancelan />
  <Despues />
</Modulo>
