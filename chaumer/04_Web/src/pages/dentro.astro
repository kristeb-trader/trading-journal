---
/**
 * Modulo 7 — Dentro de la operacion.
 *
 * El modulo mas corto y el mas duro. Dos ajustes, y despues una prohibicion
 * absoluta. Es la unica regla del plan enunciada sin excepciones.
 */
import Modulo from '../componentes/Modulo.astro';
import { seccionesDe } from '../contenido/plan/indice.mjs';
import Llenado from '../contenido/plan/dentro/llenado.astro';
import NoTocar from '../contenido/plan/dentro/no-tocar.astro';
import Salidas from '../contenido/plan/dentro/salidas.astro';
import Cerrar from '../contenido/plan/dentro/cerrar.astro';

// Los apartados viven en src/contenido/plan/dentro/ desde el 20/10/2026: los
// comparten esta página y «Reglas» (/plan). Su orden y su nombre corto, en indice.mjs.
const SECCIONES = seccionesDe('dentro');
---

<Modulo slug="dentro" secciones={SECCIONES}>
  <Llenado />
  <NoTocar />
  <Salidas />
  <Cerrar />
</Modulo>
