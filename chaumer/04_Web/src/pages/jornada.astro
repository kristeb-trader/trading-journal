---
/**
 * Modulo 4 — Jornada operativa.
 *
 * El dia paso a paso. El ancla es SIEMPRE la apertura americana, nunca el
 * numero del reloj: la hora en pantalla se desplaza con el cambio de horario
 * de Nueva York y escribirla fija seria un error a fecha conocida.
 */
import Modulo from '../componentes/Modulo.astro';
import { seccionesDe } from '../contenido/plan/indice.mjs';
import Ventana from '../contenido/plan/jornada/ventana.astro';
import Primera from '../contenido/plan/jornada/primera.astro';
import Transcurso from '../contenido/plan/jornada/transcurso.astro';
import Registro from '../contenido/plan/jornada/registro.astro';

// Los apartados viven en src/contenido/plan/jornada/ desde el 20/10/2026: los
// comparten esta página y «Reglas» (/plan). Su orden y su nombre corto, en indice.mjs.
const SECCIONES = seccionesDe('jornada');
---

<Modulo slug="jornada" secciones={SECCIONES}>
  <Ventana />
  <Primera />
  <Transcurso />
  <Registro />
</Modulo>
