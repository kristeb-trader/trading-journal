---
/**
 * Bitácora del backtesting operativo.
 *
 * Christian hace el backtesting VISUAL a mano sobre el mercado pasado. Esta
 * página GUARDA lo que él ya decidió: no lee mercado, no marca zonas, no
 * aplica reglas, no detecta setups. Si alguna vez aparece aquí lógica de la
 * metodología, es un error — el diseño está en docs/disenos/2026-09-09-bitacora-backtesting.md.
 *
 * Es la única página del portal que se pinta en el navegador y no al
 * compilar: sus datos cambian sin recompilar nada.
 *
 * DE SOLO LECTURA desde el 24/09/2026 (fase 4a de la unificación): la bitácora
 * vive en Supabase y se registra desde el Journal. Esta página la lee a través
 * de /api/backtesting, que la pide a Supabase desde el servidor. Ninguna cifra
 * de esta pantalla está escrita a mano.
 *
 * Desde el 20/10/2026 la tabla, la curva y los filtros viven en
 * componentes/Bitacora.astro, que comparte con la operativa diaria.
 */
import Marco from '../componentes/Marco.astro';
import Bitacora from '../componentes/Bitacora.astro';
---

<Marco titulo="Backtesting operativo">
  <Bitacora
    titulo="Backtesting operativo"
    api="/api/backtesting"
    conSaldo
    exportar="/api/backtesting/export"
    vacio="Todavía no hay jornadas registradas."
  />
</Marco>
