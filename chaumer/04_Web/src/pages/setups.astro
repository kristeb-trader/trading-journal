---
/**
 * Modulo 3 — Setups operativos.
 *
 * Solo hay dos, y son el reverso el uno del otro: la Continuacion opera el
 * rompimiento que funciona y el Reingreso el que fallo. Se explican por
 * separado y con la misma estructura, para que la diferencia se vea sola.
 *
 * El 23/09/2026 el setup IRI paso a llamarse Continuacion (decision del
 * operador; nada operativo cambia). IRI nombra ahora la ESTRUCTURA —impulso,
 * retroceso, impulso— sobre la que se construye la Continuacion. La seccion
 * se llama #continuacion y conserva #iri como ancla muda, para no romper un
 * enlace guardado. Ver docs/archivo/chaumer/CAMBIO_IRI_A_CONTINUACION.md.
 */
import Modulo from '../componentes/Modulo.astro';
import { seccionesDe } from '../contenido/plan/indice.mjs';
import Dos from '../contenido/plan/setups/dos.astro';
import Continuacion from '../contenido/plan/setups/continuacion.astro';
import Fluida from '../contenido/plan/setups/fluida.astro';
import Reingreso from '../contenido/plan/setups/reingreso.astro';
import Comparar from '../contenido/plan/setups/comparar.astro';

// Los apartados viven en src/contenido/plan/setups/ desde el 20/10/2026: los
// comparten esta página y «Reglas» (/plan). Su orden y su nombre corto, en indice.mjs.
const SECCIONES = seccionesDe('setups');
---

<Modulo slug="setups" secciones={SECCIONES}>
  <Dos />
  <Continuacion />
  <Fluida />
  <Reingreso />
  <Comparar />
</Modulo>
