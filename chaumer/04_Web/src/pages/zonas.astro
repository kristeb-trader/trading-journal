---
/**
 * Modulo 2 — Marcacion de zonas.
 *
 * El modulo mas largo del recorrido, y con razon: casi todo el plan se apoya
 * en que una zona este bien dibujada.
 *
 * Reestructurado el 03/09/2026 y corregido por el operador el mismo dia sobre
 * el texto del modulo (entonces en textos/, retirado el 29/09/2026). El vocabulario es suyo: se dice MOVIMIENTO (no tramo) y
 * despues del rompimiento se dice CONSECUCION (no confirmacion), que es el
 * termino del glosario.
 *
 * Solo reglas confirmadas de 01_Plan/reglas.json. Nada del PDF de parametros
 * que no este ya en el plan.
 *
 * OJO — cuatro cosas que el operador quito en su repaso y estan pendientes de
 * su respuesta (ver docs/archivo/chaumer/cowork/ESTADO_FASE_2_HISTORIAL.md, 03/09/2026; codigos ya
 * traducidos a la numeracion del 06/09/2026):
 *   - R-13 «si se tocan, se funden»: desde el 22/10/2026 (plan 3.50) se explica en
 *     «Generación de zonas» y en «La zona apéndice» (la zona ya traspasada no se estira)
 *   - de R-09 desaparecio «esa incluida» (la vela que dispara el retroceso)
 *   - de R-12 desaparecio «se mide el recorrido, no el rectangulo»
 *   - el PENDIENTE de como se entra sobre una zona apendice ya no se muestra; desde el
 *     22/10/2026 se explica que para entrar hay que romper el borde de fuera del bloque
 */
import Modulo from '../componentes/Modulo.astro';
import { seccionesDe } from '../contenido/plan/indice.mjs';
import Movimiento from '../contenido/plan/zonas/movimiento.astro';
import Nace from '../contenido/plan/zonas/nace.astro';
import Consecucion from '../contenido/plan/zonas/consecucion.astro';
import Estira from '../contenido/plan/zonas/estira.astro';
import Apendice from '../contenido/plan/zonas/apendice.astro';
import Convivencia from '../contenido/plan/zonas/convivencia.astro';
import Caduca from '../contenido/plan/zonas/caduca.astro';

// Los apartados viven en src/contenido/plan/zonas/ desde el 20/10/2026: los
// comparten esta página y «Reglas» (/plan). Su orden y su nombre corto, en indice.mjs.
const SECCIONES = seccionesDe('zonas');
---

<Modulo slug="zonas" secciones={SECCIONES}>
  <Movimiento />
  <Nace />
  <Consecucion />
  <Estira />
  <Apendice />
  <Convivencia />
  <Caduca />
</Modulo>
