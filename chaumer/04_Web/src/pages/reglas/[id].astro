---
/**
 * Ficha de una regla.
 *
 * REGLA DE ORO DE ESTA PANTALLA: un campo ausente NO SE DIBUJA. Nada de
 * guiones, nada de «sin excepciones», nada de bloques vacios.
 *
 * Desde el 26/09/2026 la ficha sigue la plantilla de las reglas (01_Plan/reglas/):
 * nombre, la regla, cómo se aplica, si no se cumple, excepciones y por qué. Todo
 * viene de la propia regla; el documento maestro ya no existe.
 *
 * Los nombres de parametro se convierten en pastillas con su valor vigente,
 * resuelto de PARAMETROS.md. Aqui no se escribe ningun numero a mano.
 *
 * Desde el 28/09/2026 (F4, diseño §4.7): el titulo y la navegacion dicen el NOMBRE de la regla y el codigo va
 * pequeño; un «Por qué» largo enseña su primer parrafo y pliega el resto; «En el gráfico» junta diagramas y
 * casos reales, y al final van las relacionadas, con su nombre.
 */
import Marco from '../../componentes/Marco.astro';
import Icono from '../../componentes/Icono.astro';
import * as P from '../../lib/parsers.mjs';

export function getStaticPaths() {
  return P.reglas().map((r) => ({ params: { id: r.id }, props: { regla: r } }));
}

const { regla } = Astro.props;
const todas = P.reglas();
const i = todas.findIndex((r) => r.id === regla.id);
const anterior = todas[i - 1] ?? null;
const siguiente = todas[i + 1] ?? null;

const casos = P.casosPorRegla().get(regla.id) ?? [];
const imagenes = P.imagenesDeReglas().get(regla.id) ?? [];

// El nombre del grupo sale del propio archivo de reglas, igual que en el
// indice. Aqui hubo un mapa escrito a mano con las doce categorias viejas.
const NOMBRE_SUB = { marcado: 'Marcado', vigencia: 'Vigencia' };
const etiquetaCat = (r) => {
  const base = r.categoria_nombre ?? r.categoria;
  return r.subcategoria ? `${base} · ${NOMBRE_SUB[r.subcategoria] ?? r.subcategoria}` : base;
};
const op = { sinEnlaceA: regla.id };
const md = (t) => P.markdownRico(t, op);

const porId = new Map(todas.map((r) => [r.id, r]));
const relacionadas = (regla.relacionadas ?? []).map((id) => porId.get(id)).filter(Boolean);

// Un «Por qué» largo se lee a trozos: se enseña el primer parrafo (y el siguiente, si el primero es un
// subtitulo) y el resto se pliega. Por debajo de LARGO no se pliega nada: plegar tres lineas estorba mas.
const LARGO = 900;
function partirPorque(t) {
  // La linea «Diagrama(s): ../02_Assets/…» del plan son rutas de archivo para quien trabaja con el plan: aquí los
  // diagramas ya salen dibujados en «En el gráfico», y las rutas no le dicen nada a quien lee la ficha.
  t = String(t || '').split('\n').filter((l) => !/^Diagramas?:\s/.test(l.trim())).join('\n');
  const trozos = t.trim().split(/\n\s*\n/);
  let n = 1;
  while (n < trozos.length && /^#{1,6}\s/.test(trozos[n - 1])) n++;
  const intro = trozos.slice(0, n).join('\n\n');
  const resto = trozos.slice(n).join('\n\n');
  return resto.length > LARGO ? { intro, resto } : { intro: t, resto: '' };
}
const porque = regla.porque ? partirPorque(regla.porque) : null;
const palabrasResto = porque?.resto ? porque.resto.split(/\s+/).filter(Boolean).length : 0;
const corto = (nombre) => (nombre.length > 38 ? nombre.slice(0, 36).replace(/\s+\S*$/, '') + '…' : nombre);
---

<Marco titulo={regla.nombre} ancho="texto">
  <nav class="paso" aria-label="Regla anterior y siguiente">
    {anterior
      ? <a class="paso-a" href={`/reglas/${anterior.id}`}>
          <Icono nombre="caret-left" />
          <span class="paso-c">
            <span class="meta">Anterior · <span class="mono">{anterior.id}</span></span>
            <span class="paso-t" title={anterior.nombre}>{corto(anterior.nombre)}</span>
          </span>
        </a>
      : <span />}
    {siguiente && (
      <a class="paso-a der" href={`/reglas/${siguiente.id}`}>
        <span class="paso-c">
          <span class="meta">Siguiente · <span class="mono">{siguiente.id}</span></span>
          <span class="paso-t" title={siguiente.nombre}>{corto(siguiente.nombre)}</span>
        </span>
        <Icono nombre="caret-right" />
      </a>
    )}
  </nav>


  <article class="ficha" data-obs-tipo="regla" data-obs-id={regla.id} data-obs-titulo={regla.enunciado.slice(0,120)}>
    <header class="f-cab entra">
      <div class="f-meta">
        <span class="f-id mono">{regla.id}</span>
        <span class="f-cat">{etiquetaCat(regla)}</span>
        {regla.aplica_a?.length > 0 && <span class="f-apl meta">{regla.aplica_a.join(' · ')}</span>}
      </div>
      <h1 class="f-e">{regla.nombre}</h1>
      <p class="f-regla" set:html={P.markdownLinea(regla.regla, op)} />
    </header>

    <section class="bloque entra">
      <h2>Cómo se aplica</h2>
      <div class="md" set:html={md(regla.como_se_aplica)} />
    </section>

    {regla.si_no_se_cumple && (
      <section class="bloque entra">
        <h2>Si no se cumple</h2>
        <div class="md" set:html={md(regla.si_no_se_cumple)} />
      </section>
    )}

    {regla.excepciones && (
      <section class="bloque entra">
        <h2>Excepciones</h2>
        <div class="md" set:html={md(regla.excepciones)} />
      </section>
    )}

    {porque && (
      <section class="bloque entra">
        <h2>Por qué</h2>
        <div class="md" set:html={md(porque.intro)} />
        {porque.resto && (
          <details class="mas">
            <summary><span class="mas-t">Seguir leyendo</span> <span class="meta">{palabrasResto} palabras más</span></summary>
            <div class="md" set:html={md(porque.resto)} />
          </details>
        )}
      </section>
    )}

    {regla.fuente && (
      <p class="fuente meta">Fuente: {regla.fuente}</p>
    )}

    {regla.pendiente && (
      <section class="bloque entra">
        <div class="aviso-p">
          <span class="ap-cab"><Icono nombre="warning-diamond" /> Tiene un punto abierto</span>
          <p class="ap-x" set:html={P.markdownLinea(regla.pendiente, op)} />
        </div>
      </section>
    )}

    {(imagenes.length > 0 || casos.length > 0) && (
      <section class="bloque entra">
        <h2>En el gráfico</h2>
        {imagenes.map((im) => (
          <figure class="fig">
            <div class="marco-gr"><img src={im.url} alt={`Diagrama de ${regla.nombre}`} loading="lazy" /></div>
            <figcaption class="meta">
              {im.papel === 'contraejemplo' ? 'Contraejemplo: marcado que NO es válido' : 'Diagrama de la regla'}
            </figcaption>
          </figure>
        ))}
        {casos.length > 0 && (
          <>
            <h3 class="sub">Casos reales que la citan</h3>
            <ul class="casos">
              {casos.map((c) => (
                <li><a href={`/galeria#${c.id}`}><span class="mono">{c.id}</span> {c.titulo}</a></li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}

    {relacionadas.length > 0 && (
      <section class="bloque entra">
        <h2>Relacionadas</h2>
        <ul class="rel">
          {relacionadas.map((r) => (
            <li><a href={`/reglas/${r.id}`}><span class="mono">{r.id}</span> {r.nombre}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>

</Marco>

<style>
  .volver {
    display: inline-flex; align-items: center; gap: var(--e-2);
    font-size: var(--t-3); color: var(--texto-3);
    margin-bottom: var(--e-6);
  }
  .volver:hover { color: var(--texto); }

  /* ── cabecera ────────────────────────────────────────────────────────── */
  .f-cab { margin-bottom: var(--e-7); }
  .f-meta { display: flex; align-items: center; gap: var(--e-3); flex-wrap: wrap; }
  /* El codigo va pequeño (diseño §4.7): lo que se lee es el nombre. */
  .f-id { font-size: var(--t-1); color: var(--texto-3); }
  .f-cat {
    font-size: var(--t-1); color: var(--texto-3);
    letter-spacing: var(--track-etiqueta); text-transform: uppercase;
  }
  .f-apl { margin-left: auto; }
  .f-e {
    margin: var(--e-5) 0 var(--e-3);
    font-size: var(--t-7); line-height: 1.25;
    /* Sin tope: `text-wrap: pretty` deja que el titular llene
       la columna como todo lo demas. */
  }
  /* Una ruta larga en `código` o una tabla ancha no pueden empujar la página en el
     móvil: el código se parte y la tabla se desplaza dentro de su caja. */
  .ficha :global(.md code) { overflow-wrap: anywhere; }
  .ficha :global(.md table) { display: block; max-width: 100%; overflow-x: auto; }

  .f-regla {
    margin: 0; max-width: var(--medida);
    font-size: var(--t-5); line-height: 1.5; color: var(--texto-2);
  }

  /* ── bloques ─────────────────────────────────────────────────────────── */
  .bloque { margin-bottom: var(--e-7); }
  .bloque h2 {
    margin: 0 0 var(--e-4);
    font-size: var(--t-1); font-weight: var(--peso-fuerte);
    letter-spacing: var(--track-etiqueta); text-transform: uppercase;
    color: var(--texto-3);
  }
  .cuerpo { font-size: var(--t-4); color: var(--texto-2); max-width: var(--medida); }

  .c-var { color: var(--texto-2); font-size: var(--t-2); white-space: nowrap; }
  .c-op { color: var(--acento); text-align: center; }
  .c-tf { color: var(--texto-3); font-size: var(--t-1); white-space: nowrap; }

  .excepciones, .casos { margin: 0; padding-left: var(--e-5); color: var(--texto-2); font-size: var(--t-3); }
  .casos { list-style: none; padding: 0; display: grid; gap: var(--e-2); }
  .casos a { display: inline-flex; gap: var(--e-3); }
  .casos .mono { color: var(--texto-3); font-size: var(--t-2); }

  .fuente { margin: calc(-1 * var(--e-5)) 0 var(--e-7); }

  /* ── «Por qué» plegado y relacionadas ────────────────────────────────── */
  .mas { margin-top: var(--e-4); }
  .mas summary {
    display: inline-flex; align-items: baseline; gap: var(--e-3);
    cursor: pointer; list-style: none;
    padding: var(--e-2) var(--e-4);
    border-radius: var(--radio-2);
    border: 1px solid var(--vidrio-borde);
    background: var(--vidrio-fondo);
  }
  .mas summary::-webkit-details-marker { display: none; }
  .mas summary:hover { border-color: var(--n-600); }
  .mas-t { color: var(--acento); font-size: var(--t-3); }
  .mas[open] summary { margin-bottom: var(--e-5); }
  .mas[open] .mas-t::after { content: ' ·  plegar'; color: var(--texto-3); }
  .sub {
    margin: var(--e-6) 0 var(--e-3);
    font-size: var(--t-1); font-weight: var(--peso-fuerte); color: var(--texto-3);
  }
  .rel { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e-2); font-size: var(--t-3); }
  .rel a { display: inline-flex; gap: var(--e-3); }
  /* El código no se parte: en el móvil salía «G-» arriba y «03» abajo. */
  .rel .mono, .casos .mono { color: var(--texto-3); font-size: var(--t-2); flex: none; white-space: nowrap; }
  @media print { .mas summary { display: none; } .mas > .md { display: block; } }

  /* ── punto abierto ───────────────────────────────────────────────────── */
  .aviso-p {
    padding: var(--e-5);
    border-radius: var(--radio-3);
    background: color-mix(in srgb, var(--aviso) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--aviso) 26%, transparent);
  }
  .ap-cab {
    display: flex; align-items: center; gap: var(--e-2);
    font-size: var(--t-3); font-weight: var(--peso-fuerte); color: var(--aviso);
  }
  .ap-x { margin: var(--e-3) 0; font-size: var(--t-3); color: var(--texto-2); }

  .fig { margin: 0 0 var(--e-5); }
  .fig figcaption { margin-top: var(--e-3); }


  /* ── anterior y siguiente ────────────────────────────────────────────── */
  /* La navegacion va ARRIBA desde el 06/09/2026: «anterior» ocupa el sitio
     que tenia el enlace a todas las reglas, y «siguiente» el lado opuesto. */
  .paso {
    display: flex; justify-content: space-between; align-items: center;
    gap: var(--e-3);
    margin: 0 0 var(--e-6);
  }
  .paso-a {
    display: flex; align-items: center; gap: var(--e-3);
    padding: var(--e-2) var(--e-4);
    border-radius: var(--radio-2);
    border: 1px solid var(--vidrio-borde);
    background: var(--vidrio-fondo);
    color: var(--texto-2);
    transition: background var(--normal), border-color var(--normal), transform var(--normal);
  }
  .paso-a:hover {
    background: rgba(255, 255, 255, 0.06); color: var(--texto);
    border-color: var(--n-600);
  }
  .paso-a:hover :global(.icono) { color: var(--acento); }
  .paso-a.der { text-align: right; margin-left: auto; }
  .paso-a :global(.icono) { --i: 0.95rem; color: var(--texto-3); flex: none; }
  .paso-c { display: grid; line-height: 1.25; }

  /* El boton de comentar deja de flotar arriba a la derecha y se coloca al
     final, despues de la tabla. Lo pidio el operador: arriba estorbaba. */
  .ficha :global(.obs-btn) {
    position: static; opacity: 1;
    margin-top: var(--e-8);
  }
  .paso-t { font-size: var(--t-3); color: var(--texto); }
</style>
