---
/**
 * Las 38 reglas — el índice, en lista.
 *
 * El operador el 06/09/2026: nada de tarjetas. Una lista ordenada por
 * categoría, que se lea de arriba abajo y se interprete de un vistazo.
 *
 *   · Cada grupo con su cabecera, su color y su cuenta. Zonas parte además
 *     en sus dos apartados, marcado y vigencia.
 *   · El grupo se elige en el menú de la izquierda y viaja en el ancla
 *     (#g=zonas, #g=zonas.marcado): al elegirlo, la página deja solo ese.
 *   · El buscador filtra por texto sobre lo que haya a la vista.
 *
 * Los nombres de los grupos y su orden salen de reglas.json. Aquí no se
 * renombra ninguno ni se decide el orden.
 */
import Marco from '../../componentes/Marco.astro';
import Icono from '../../componentes/Icono.astro';
import * as P from '../../lib/parsers.mjs';

const reglas = P.reglas();
const cats = P.categorias();
const casos = P.casosPorRegla();
const imagenes = P.imagenesDeReglas();

const NOMBRE_SUB = { marcado: 'Marcado', vigencia: 'Vigencia' };

// Del cian al azul, en el orden que declara el archivo. El mismo cálculo que
// hace el menú, para que el color de un grupo sea el mismo en los dos sitios.
const TONO = new Map(cats.map((c, i) => [
  c.id,
  `color-mix(in srgb, var(--info) ${Math.round(100 - (i * 100) / Math.max(cats.length - 1, 1))}%, var(--acento))`,
]));

const tambien = (r) => P.ENLACES_CRUZADOS.get(r.id) ?? [];

/** Las reglas de un grupo, partidas por apartado si los tiene. */
function bloques(c) {
  const suyas = reglas.filter((r) => r.categoria === c.id);
  if (c.subs.length < 2) return [{ sub: null, titulo: null, reglas: suyas }];
  return c.subs.map((sb) => ({
    sub: sb.id,
    titulo: NOMBRE_SUB[sb.id] ?? sb.id,
    reglas: suyas.filter((r) => r.subcategoria === sb.id),
  }));
}
---

<Marco titulo="Reglas">
  <header class="cab entra">
    <h1>Reglas Trading Plan</h1>
    <p class="lead">
      Las {reglas.length} del método, con sus condiciones medibles y su acción.
      Sin adjetivos: solo ticks, puntos, número de velas y horas exactas.
    </p>
  </header>

  <div class="barra entra">
    <label class="campo">
      <Icono nombre="magnifying-glass" />
      <input type="search" data-filtro autocomplete="off" spellcheck="false"
             placeholder="Buscar por texto o por número de regla" />
      <kbd class="kbd">Ctrl K</kbd>
    </label>
    <p class="estado">
      <span class="grupo" data-grupo-activo hidden></span>
      <span class="cuenta meta"><b data-contador>{reglas.length}</b> de {reglas.length}</span>
    </p>
  </div>

  <p class="vacio" data-vacio hidden>
    Ninguna regla coincide. Prueba con otra palabra, o elige «Todas» en el menú.
  </p>

  {cats.map((c) => (
    <section class="grupo-s" data-grupo-s={c.id} style={`--c:${TONO.get(c.id)}`}>
      <header class="g-cab">
        <span class="g-p" aria-hidden="true"></span>
        <h2>{c.nombre}</h2>
        <span class="g-n">{c.n}</span>
        {c.descripcion && <span class="g-d">{c.descripcion}</span>}
      </header>

      {bloques(c).map((b) => (
        <div class="apartado" data-sub-s={b.sub ?? ''}>
          {b.titulo && (
            <h3 class="a-t">{b.titulo}<span class="a-n">{b.reglas.length}</span></h3>
          )}
          <ul class="lista">
            {b.reglas.map((r) => (
              <li class="fila"
                  data-cat={r.categoria}
                  data-sub={r.subcategoria ?? ''}
                  data-tambien={tambien(r).join(' ')}
                  data-txt={[r.id, r.enunciado, r.accion, r.nota].filter(Boolean).join(' ').toLowerCase()}>
                <a href={`/reglas/${r.id}`}>
                  <span class="f-id mono">{r.id}</span>
                  <span class="f-e">{r.enunciado}</span>
                  <span class="f-met">
                    <span class="met" title="Condiciones medibles">
                      <Icono nombre="list-checks" />{r.condiciones.length}
                    </span>
                    {casos.has(r.id) && (
                      <span class="met" title="Casos reales que la citan">
                        <Icono nombre="images" />{casos.get(r.id).length}
                      </span>
                    )}
                    {imagenes.has(r.id) && (
                      <span class="met" title="Tiene diagrama"><Icono nombre="image-square" /></span>
                    )}
                  </span>
                  <span class="f-ir" aria-hidden="true"><Icono nombre="caret-right" /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  ))}
</Marco>

<script is:inline define:vars={{ NOMBRES: Object.fromEntries(cats.map((c) => [c.id, c.nombre])), SUBS: NOMBRE_SUB }}>
  (function () {
    var campo = document.querySelector('[data-filtro]');
    if (!campo) return;

    var filas = [].slice.call(document.querySelectorAll('.fila'));
    var secciones = [].slice.call(document.querySelectorAll('[data-grupo-s]'));
    var apartados = [].slice.call(document.querySelectorAll('[data-sub-s]'));
    var contador = document.querySelector('[data-contador]');
    var vacio = document.querySelector('[data-vacio]');
    var rotulo = document.querySelector('[data-grupo-activo]');

    var cat = '';
    var sub = '';

    function aplicar() {
      var q = campo.value.trim().toLowerCase();
      var n = 0;
      filas.forEach(function (f) {
        // Una regla entra por su grupo o por aquellos desde los que TAMBIÉN
        // contesta: la del rompimiento vive en Zonas y responde en Setup.
        var suyas = (f.getAttribute('data-cat') + ' ' + (f.getAttribute('data-tambien') || '')).split(' ');
        var okCat = !cat || suyas.indexOf(cat) >= 0;
        var okSub = !sub || f.getAttribute('data-sub') === sub;
        var okTxt = !q || f.getAttribute('data-txt').indexOf(q) >= 0;
        var ver = okCat && okSub && okTxt;
        f.hidden = !ver;
        if (ver) n++;
      });

      // Un apartado o un grupo sin ninguna fila a la vista se esconde entero:
      // si no, quedan cabeceras huérfanas.
      apartados.forEach(function (a) {
        a.hidden = !a.querySelector('.fila:not([hidden])');
      });
      secciones.forEach(function (s) {
        s.hidden = !s.querySelector('.fila:not([hidden])');
      });

      contador.textContent = n;
      vacio.hidden = n > 0;

      var nombre = cat ? (NOMBRES[cat] || cat) : '';
      if (nombre && sub) nombre += ' · ' + (SUBS[sub] || sub);
      rotulo.textContent = nombre;
      rotulo.hidden = !nombre;
    }

    function delAncla() {
      var m = /^#g=([a-z_]+)(?:\.([a-z_]+))?$/.exec(location.hash || '');
      cat = m ? m[1] : '';
      sub = m && m[2] ? m[2] : '';
      var clave = cat + (sub ? '.' + sub : '');
      document.querySelectorAll('[data-grupo]').forEach(function (a) {
        a.classList.toggle('activa', a.getAttribute('data-grupo') === clave);
      });
      aplicar();
    }

    window.addEventListener('hashchange', delAncla);
    campo.addEventListener('input', aplicar);

    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
        e.preventDefault(); campo.focus(); campo.select(); return;
      }
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      var d = document.activeElement;
      if (d && (d.tagName === 'INPUT' || d.tagName === 'TEXTAREA' || d.isContentEditable)) return;
      if (e.key === 'Escape' && campo.value) { campo.value = ''; aplicar(); return; }
      if (e.key.length !== 1 || !/[\wáéíóúñ-]/i.test(e.key)) return;
      campo.focus();
    });

    delAncla();
  })();
</script>

<style>
  .cab { text-align: center; margin: calc(var(--e-6) * -1) 0 var(--e-7); }
  .cab h1 {
    margin: 0 0 var(--e-3);
    font-size: clamp(var(--t-7), 3vw, var(--t-8));
    text-transform: uppercase; letter-spacing: 0.03em;
    color: var(--acento); text-wrap: pretty;
  }
  .lead { font-size: var(--t-5); color: var(--texto-2); margin: 0 auto; }

  /* ── buscador ─────────────────────────────────────────────────────── */
  .barra {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-3) var(--e-4);
    margin-bottom: var(--e-7);
  }
  .campo {
    flex: 1 1 22rem;
    display: flex; align-items: center; gap: var(--e-3);
    padding: var(--e-3) var(--e-4);
    background: var(--vidrio-fondo);
    border: 1px solid var(--vidrio-borde);
    border-radius: var(--radio-2);
    backdrop-filter: var(--desenfoque);
    color: var(--texto-3);
    transition: border-color var(--normal), box-shadow var(--normal);
  }
  .campo:focus-within {
    border-color: color-mix(in srgb, var(--acento) 60%, transparent);
    box-shadow: var(--halo-azul);
  }
  .campo input {
    flex: 1; min-width: 0; background: none; border: 0; outline: none;
    color: var(--texto); font: inherit; font-size: var(--t-3);
  }
  .campo input::placeholder { color: var(--texto-3); }
  .campo input::-webkit-search-cancel-button { display: none; }
  .kbd {
    font-family: var(--fuente-mono); font-size: var(--t-1);
    padding: 0.1rem 0.4rem; border-radius: var(--radio-1);
    border: 1px solid var(--borde-sutil); color: var(--texto-3); white-space: nowrap;
  }
  .estado { display: flex; align-items: center; gap: var(--e-3); margin: 0; }
  .grupo {
    font-size: var(--t-2); color: var(--texto-2);
    padding: var(--e-1) var(--e-3); border-radius: var(--radio-pill);
    background: color-mix(in srgb, var(--acento) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--acento) 40%, transparent);
  }
  .grupo[hidden] { display: none; }
  .cuenta { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cuenta b { color: var(--texto); font-weight: var(--peso-medio); }
  .vacio { color: var(--texto-2); font-size: var(--t-3); padding: var(--e-6) 0; }

  /* ── grupo ────────────────────────────────────────────────────────── */
  .grupo-s { margin-bottom: var(--e-8); }
  .grupo-s[hidden] { display: none; }

  .g-cab {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--e-3);
    padding-bottom: var(--e-3);
    margin-bottom: var(--e-4);
    border-bottom: 1px solid var(--borde-sutil);
  }
  .g-p {
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: var(--c); align-self: center;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 18%, transparent);
  }
  .g-cab h2 {
    margin: 0; font-size: var(--t-6); color: var(--texto);
    font-weight: var(--peso-medio);
  }
  .g-n {
    font-size: var(--t-1); color: var(--c);
    font-variant-numeric: tabular-nums;
    padding: 0.1rem var(--e-2); border-radius: var(--radio-pill);
    background: color-mix(in srgb, var(--c) 16%, transparent);
  }
  .g-d { flex: 1 1 14rem; font-size: var(--t-2); color: var(--texto-3); }

  .apartado[hidden] { display: none; }
  .a-t {
    display: flex; align-items: center; gap: var(--e-2);
    margin: var(--e-5) 0 var(--e-2);
    font-size: var(--t-1); color: var(--texto-3);
    letter-spacing: var(--track-etiqueta); text-transform: uppercase;
  }
  .a-n { color: var(--texto-3); font-variant-numeric: tabular-nums; opacity: 0.7; }

  /* ── la lista ─────────────────────────────────────────────────────── */
  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .fila { margin: 0; }
  .fila[hidden] { display: none; }

  .fila > a {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto auto;
    align-items: center; gap: var(--e-4);
    padding: var(--e-3) var(--e-4);
    border-radius: var(--radio-2);
    border: 1px solid transparent;
    color: var(--texto-2);
    transition: background var(--normal), border-color var(--normal), transform var(--normal);
  }
  .fila > a:hover, .fila > a:focus-visible {
    background: var(--vidrio-fondo);
    border-color: color-mix(in srgb, var(--c) 34%, var(--vidrio-borde));
    color: var(--texto-2);
    transform: translateX(2px);
  }

  .f-id {
    font-size: var(--t-1); color: var(--c);
    padding: 0.12rem var(--e-2); border-radius: var(--radio-1);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    text-align: center;
  }
  .f-e { font-size: var(--t-3); color: var(--texto); line-height: 1.45; }

  .f-met { display: flex; align-items: center; gap: var(--e-3); }
  .met {
    display: inline-flex; align-items: center; gap: var(--e-1);
    --i: 0.85rem; font-size: var(--t-1); color: var(--texto-3);
    font-variant-numeric: tabular-nums;
  }
  .f-ir {
    display: flex; --i: 0.95rem; color: var(--texto-3);
    opacity: 0; transition: opacity var(--normal), transform var(--normal);
  }
  .fila > a:hover .f-ir { opacity: 1; transform: translateX(2px); color: var(--c); }

  @media (max-width: 46rem) {
    .fila > a { grid-template-columns: 3.2rem minmax(0, 1fr); gap: var(--e-3); }
    .f-met { grid-column: 2; }
    .f-ir { display: none; }
  }
</style>
