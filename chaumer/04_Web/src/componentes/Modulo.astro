---
/**
 * Modulo — la envoltura de cada uno de los ocho pasos del metodo.
 *
 * UN APARTADO A LA VEZ — pedido por el operador el 02/09/2026.
 *
 * Antes el modulo era una pagina larga y se bajaba con el scroll. Ahora cada
 * apartado es una parada: se ve uno solo, y se pasa al siguiente pulsando en
 * la ruta de arriba o el boton del pie. La ruta va numerada y con la linea
 * que une las paradas porque el recorrido ES secuencial: los apartados estan
 * en el orden en que se hacen las cosas, no son pestanas intercambiables.
 *
 * El pie encadena: al final del ultimo apartado, «siguiente» ya no es un
 * apartado sino el modulo siguiente. Los ocho modulos y sus apartados se
 * recorren enteros sin volver nunca al menu.
 *
 * SIN JAVASCRIPT se ven todos los apartados seguidos, como antes. Ocultar es
 * cosa del navegador: el HTML lleva el contenido completo.
 *
 * El indice se declara a mano en cada pagina (no se deduce del HTML) porque
 * asi la pagina decide que apartados merecen parada y cuales no.
 */
import Marco from './Marco.astro';
import Icono from './Icono.astro';
import { MODULOS, modulo, vecinos } from '../lib/modulos.mjs';

interface Props {
  slug: string;
  secciones?: { id: string; t: string }[];
}
const { slug, secciones = [] } = Astro.props;

const m = modulo(slug);
const { anterior, siguiente } = vecinos(slug);
const dos = (n: number) => String(n).padStart(2, '0');

const destinoFinal = siguiente
  ? { href: '/' + siguiente.slug, etiqueta: 'Siguiente módulo', texto: siguiente.titulo }
  : { href: '/galeria', etiqueta: 'Y para terminar', texto: 'Los casos reales' };
---

<Marco titulo={m.titulo}>
  <div class="mod" data-mod style={`--tono-mod: ${m.tono}`}>
    <header class="mod-cab">
      <h1>{m.titulo}</h1>
      <p class="lead">{m.sub}</p>
    </header>

    <!-- ── la ruta del modulo ─────────────────────────────────────────── -->
    {secciones.length > 0 && (
      <nav class="ruta" aria-label={`Apartados de ${m.titulo}`}>
        <ol class="ruta-l">
          {secciones.map((s, i) => (
            <li class="ruta-i" data-paso-i={i}>
              <a href={`#${s.id}`} data-paso={s.id}>
                <span class="ri-p" aria-hidden="true">
                  <span class="ri-n num">{i + 1}</span>
                  <span class="ri-ok"><Icono nombre="check" peso="bold" /></span>
                </span>
                <span class="ri-t">{s.t}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="mod-cuerpo">
      <slot />
    </div>

    <!-- ── el pie que encadena ─────────────────────────────────────────── -->
    <nav class="mod-pie" aria-label="Continuar" data-pie>
      <a class="mp mp-a" data-atras href={anterior ? `/${anterior.slug}` : '/'}>
        <Icono nombre="arrow-left" />
        <span>
          <span class="mp-e meta" data-atras-e>{anterior ? 'Módulo anterior' : 'Volver'}</span>
          <span class="mp-t" data-atras-t>{anterior ? anterior.titulo : 'Inicio'}</span>
        </span>
      </a>

      <p class="mp-cuenta meta" data-cuenta hidden></p>

      <a class="mp mp-s" data-alante href={destinoFinal.href}>
        <span>
          <span class="mp-e meta" data-alante-e>{destinoFinal.etiqueta}</span>
          <span class="mp-t" data-alante-t>{destinoFinal.texto}</span>
        </span>
        <Icono nombre="arrow-right" />
      </a>
    </nav>
  </div>
</Marco>

<script
  is:inline
  define:vars={{
    pasos: secciones.map((s) => s.id),
    nombres: secciones.map((s) => s.t),
    final: destinoFinal,
    atrasModulo: anterior
      ? { href: '/' + anterior.slug, etiqueta: 'Módulo anterior', texto: anterior.titulo }
      : { href: '/', etiqueta: 'Volver', texto: 'Inicio' },
  }}
>
  // Un apartado a la vez. Sin JavaScript no se ejecuta nada de esto y la
  // pagina se queda como una lectura larga y completa, que es un buen
  // resultado por si solo.
  (function () {
    if (!pasos.length) return;

    var raiz = document.querySelector('[data-mod]');
    var enlaces = Array.prototype.slice.call(document.querySelectorAll('[data-paso]'));
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-paso-i]'));
    var secs = pasos.map(function (id) { return document.getElementById(id); });
    if (secs.some(function (s) { return !s; })) return;

    var atras = document.querySelector('[data-atras]');
    var atrasE = document.querySelector('[data-atras-e]');
    var atrasT = document.querySelector('[data-atras-t]');
    var alante = document.querySelector('[data-alante]');
    var alanteE = document.querySelector('[data-alante-e]');
    var alanteT = document.querySelector('[data-alante-t]');
    var cuenta = document.querySelector('[data-cuenta]');

    raiz.classList.add('por-pasos');
    cuenta.hidden = false;

    // Cada apartado es un destino de foco: al cambiar de parada, el lector
    // de pantalla y el teclado aterrizan en el titulo, no al principio.
    secs.forEach(function (s) { s.setAttribute('tabindex', '-1'); });

    var actual = -1;

    function pintar(i, mover) {
      if (i < 0 || i >= pasos.length || i === actual) return;
      actual = i;

      secs.forEach(function (s, j) { s.hidden = j !== i; });

      // Las imagenes con loading="lazy" de un apartado que arranca oculto
      // nunca cargan solas: el navegador calcula si estan lejos del viewport
      // ANTES de que este script las oculte, y al mostrarlas despues no
      // vuelve a intentarlo. Se fuerza la carga la primera vez que su
      // apartado se ve.
      secs[i].querySelectorAll('img[loading="lazy"]').forEach(function (img) {
        if (!img.complete || img.naturalWidth === 0) {
          img.loading = 'eager';
          img.src = img.src;
        }
      });

      items.forEach(function (li, j) {
        li.classList.toggle('hecho', j < i);
        li.classList.toggle('aqui', j === i);
      });
      enlaces.forEach(function (a, j) {
        if (j === i) a.setAttribute('aria-current', 'step');
        else a.removeAttribute('aria-current');
      });

      cuenta.textContent = 'Apartado ' + (i + 1) + ' de ' + pasos.length;

      // El pie encadena: dentro del modulo mueve de apartado; en los extremos
      // salta al modulo de al lado.
      if (i === 0) {
        atras.href = atrasModulo.href;
        atrasE.textContent = atrasModulo.etiqueta;
        atrasT.textContent = atrasModulo.texto;
      } else {
        atras.href = '#' + pasos[i - 1];
        atrasE.textContent = 'Apartado anterior';
        atrasT.textContent = nombres[i - 1];
      }

      if (i === pasos.length - 1) {
        alante.href = final.href;
        alanteE.textContent = final.etiqueta;
        alanteT.textContent = final.texto;
        alante.classList.add('mp-fin');
      } else {
        alante.href = '#' + pasos[i + 1];
        alanteE.textContent = 'Siguiente apartado';
        alanteT.textContent = nombres[i + 1];
        alante.classList.remove('mp-fin');
      }

      // Traer la parada activa a la vista cuando la ruta se desliza.
      var li = items[i];
      var tira = document.querySelector('.ruta-l');
      if (tira && tira.scrollWidth > tira.clientWidth) {
        var r = li.getBoundingClientRect(), c = tira.getBoundingClientRect();
        if (r.left < c.left || r.right > c.right) {
          tira.scrollTo({
            left: tira.scrollLeft + (r.left - c.left) - (c.width - r.width) / 2,
            behavior: 'smooth',
          });
        }
      }

      if (mover) {
        // El «-16» a secas dejaba el titulo TAPADO por la cabecera fija: si
        // el usuario ya habia bajado (leyendo un apartado largo) y saltaba a
        // otro, el titulo aterrizaba detras de la barra superior, que se ve
        // encima de todo. Hay que restar tambien lo que mide esa barra, no
        // un numero fijo — y de paso se lee en directo, porque en movil la
        // cabecera es mas alta (dos filas) que en escritorio.
        var cabecera = document.querySelector('.cabecera');
        var altoCabecera = cabecera ? cabecera.getBoundingClientRect().height : 0;
        var arriba = raiz.getBoundingClientRect().top + window.scrollY - altoCabecera - 16;
        window.scrollTo({ top: Math.max(arriba, 0), behavior: 'smooth' });
        secs[i].focus({ preventScroll: true });
      }
    }

    function porHash(mover) {
      var id = decodeURIComponent(location.hash.replace('#', ''));
      var i = pasos.indexOf(id);
      // Un ancla que vive DENTRO de un apartado abre ese apartado. Es lo que
      // mantiene vivo /setups#iri, la direccion de la seccion antes de que el
      // setup se llamara Continuacion (23/09/2026).
      if (i < 0 && id) {
        var el = document.getElementById(id);
        for (var j = 0; el && j < secs.length; j++) if (secs[j].contains(el)) { i = j; break; }
      }
      pintar(i >= 0 ? i : 0, mover);
    }

    // Cualquier enlace a un apartado abre esa parada, venga de la ruta, del
    // pie o de un enlace dentro del texto.
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href^="#"]');
      if (!a) return;
      var i = pasos.indexOf(a.getAttribute('href').slice(1));
      if (i < 0) return;
      e.preventDefault();
      history.pushState(null, '', '#' + pasos[i]);
      pintar(i, true);
    });

    addEventListener('popstate', function () { porHash(true); });
    porHash(false);
  })();
</script>

<style>
  /* Una sola columna de lectura para todo el modulo: texto, avisos, tarjetas
     y graficos. Antes el contenedor media 1145px y los parrafos paraban en
     699 (la medida de 62ch), asi que sobraban 446px a la derecha mientras los
     avisos si llegaban al borde. Eso es lo que se leia como una pared. */
  /* Un poco mas arriba que el resto de paginas: con el titulo centrado y
     grande, el aire por defecto de .contenido se notaba de sobra. Solo aqui,
     no se toca el relleno compartido de Marco.astro. */
  .mod { min-width: 0; margin-top: calc(var(--e-6) * -1); }

  /* ── portada del modulo ────────────────────────────────────────────── */
  /* El titulo principal lleva el tono del modulo (el mismo cian→azul del
     menu), centrado y en mayusculas: es el mismo tratamiento del titulo de
     cada apartado, intercambiado con el titulo principal — pedido por el
     operador el 03/09/2026. Antes «Premercado» iba en blanco y el apartado
     «Cómo estoy hoy» llevaba el color; ahora es al reves. */
  .mod-cab { margin-bottom: var(--e-7); text-align: center; }
  .mod-cab h1 {
    margin: 0 0 var(--e-3);
    font-size: clamp(var(--t-7), 3vw, var(--t-8));
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--tono-mod, var(--acento));
    text-wrap: pretty;
  }
  .mod-cab .lead {
    font-size: var(--t-5); color: var(--texto-2);
    margin: 0 auto;
  }

  /* ── la ruta ───────────────────────────────────────────────────────── */
  .ruta {
    margin-bottom: var(--e-7);
    padding: var(--e-5) var(--e-4) var(--e-4);
    border-radius: var(--radio-4);
    background: var(--vidrio-fondo);
    background-image: var(--vidrio-brillo);
    border: 1px solid var(--vidrio-borde);
  }
  .ruta-l {
    list-style: none; margin: 0; padding: 0; max-width: none;
    /* `stretch`, no `flex-start`: todas las paradas miden lo que la mas alta,
       asi el pie de la ruta es una linea recta aunque un titulo ocupe dos
       renglones y su vecino uno. Con `flex-start` la fila salia dentada. */
    display: flex; align-items: stretch;
  }
  .ruta-l::-webkit-scrollbar { display: none; }
  .ruta-i { flex: 1 1 0; min-width: 0; margin: 0; position: relative; }

  /* La linea que une las paradas. Es lo que dice «esto va en orden»: sin
     ella son pestanas, con ella es un recorrido. */
  .ruta-i + .ruta-i::before {
    content: '';
    position: absolute; z-index: 0;
    top: 1.125rem; left: -50%; right: 50%;
    height: 2px;
    background: var(--borde);
    transition: background var(--normal);
  }
  .ruta-i.hecho::before, .ruta-i.aqui::before { background: var(--acento); }

  /* `text-align-last` ADEMAS de `text-align`: la parada es un <li>, y la
     regla comun de justificado de base.css le deja la ultima linea a la
     izquierda. Como esa propiedad se hereda, el titulo de la parada salia
     con la primera linea centrada y la segunda corrida hacia la izquierda
     —hasta 36px—; el operador lo vio en zonas, en «Rompimiento y
     consecucion» y «Cuando quitar una zona», que son los dos titulos que
     mas parten. Centrar solo con `text-align` no basta. */
  .ruta-i > a {
    position: relative; z-index: 1;
    display: grid; justify-items: center; align-content: start; gap: var(--e-2);
    height: 100%;
    padding: 0 var(--e-2);
    color: var(--texto-3);
    text-align: center;
    text-align-last: center;
  }

  /* La parada: circulo con su numero. Grande a proposito — es el control
     principal de la pagina. */
  .ri-p {
    position: relative;
    display: grid; place-items: center;
    width: 2.25rem; height: 2.25rem;
    border-radius: 50%;
    background: var(--fondo);
    box-shadow: inset 0 0 0 2px var(--borde);
    font-size: var(--t-3);
    transition: background var(--normal), box-shadow var(--normal), color var(--normal);
  }
  .ri-n, .ri-ok { grid-area: 1 / 1; display: grid; place-items: center; }
  .ri-ok { --i: 0.875rem; opacity: 0; }
  .ri-t {
    font-size: var(--t-2);
    line-height: 1.3;
    /* Dos renglones reservados SIEMPRE. El operador lo vio en zonas: «Rompimiento
       y consecucion» ocupaba dos lineas y sus vecinos una, y la fila quedaba
       corrida. Ahora todos ocupan lo mismo y los titulos arrancan a la misma
       altura. */
    min-height: 2.6em;
    /* Tres lineas como maximo: con ocho paradas la columna es estrecha y a
       dos lineas se cortaban titulos enteros. */
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .ruta-i > a:hover { color: var(--texto); }
  .ruta-i > a:hover .ri-p { box-shadow: inset 0 0 0 2px var(--n-500); }

  /* Hecha: relleno tenue y una marca de verificado en lugar del numero. Dos
     senales, no solo el color. */
  .ruta-i.hecho > a { color: var(--texto-2); }
  .ruta-i.hecho .ri-p {
    background: color-mix(in srgb, var(--acento) 18%, transparent);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--acento) 45%, transparent);
    color: var(--acento);
  }
  .ruta-i.hecho .ri-n { opacity: 0; }
  .ruta-i.hecho .ri-ok { opacity: 1; }

  /* Aqui: relleno de acento y halo. Se ve de un vistazo donde se esta. */
  .ruta-i.aqui > a { color: var(--texto); font-weight: var(--peso-medio); }
  .ruta-i.aqui .ri-p {
    background: var(--acento);
    color: var(--sobre-acento);
    box-shadow: inset 0 0 0 2px var(--acento),
                0 0 0 4px color-mix(in srgb, var(--acento) 18%, transparent),
                var(--halo-boton);
  }

  /* ── cuerpo ────────────────────────────────────────────────────────── */
  /* Con JavaScript, el ultimo apartado no arrastra su margen al pie. */
  .por-pasos .mod-cuerpo :global(.ap:last-child) { margin-bottom: 0; }
  .por-pasos .mod-cuerpo :global(.ap:focus) { outline: none; }

  /* ── pie ───────────────────────────────────────────────────────────── */
  .mod-pie {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--e-4);
    margin-top: var(--e-8);
    padding-top: var(--e-6);
    border-top: 1px solid var(--borde-sutil);
  }
  .mp {
    display: flex; align-items: center; gap: var(--e-3);
    padding: var(--e-4) var(--e-5);
    border: 1px solid var(--vidrio-borde);
    border-radius: var(--radio-3);
    background: var(--vidrio-fondo);
    color: var(--texto-2);
    transition: border-color var(--normal), background var(--normal), color var(--normal);
  }
  .mp:hover { border-color: var(--n-600); background: var(--vidrio-hover); color: var(--texto); }
  .mp-s { justify-content: flex-end; text-align: right; }
  /* La ultima parada lleva al modulo siguiente: se marca como accion
     principal, que es el paso que de verdad continua el recorrido. */
  .mp-fin {
    background: var(--acento); color: var(--sobre-acento);
    border-color: transparent;
    box-shadow: var(--halo-boton);
  }
  .mp-fin:hover { background: var(--acento-vivo); color: var(--sobre-acento); border-color: transparent; }
  .mp-fin:focus-visible { outline-color: var(--texto); }
  .mp-e { display: block; }
  .mp-fin .mp-e { color: color-mix(in srgb, var(--sobre-acento) 72%, transparent); }
  .mp-t { display: block; font-size: var(--t-3); font-weight: var(--peso-medio); }
  .mp-cuenta { margin: 0; white-space: nowrap; }

  @media (max-width: 900px) {
    .ruta { padding: var(--e-4) var(--e-2) var(--e-3); }
    /* En vertical la ruta se desliza: las paradas no se aplastan. */
    .ruta-l { overflow-x: auto; scrollbar-width: none; }
    .ruta-i { flex: 0 0 6.5rem; }
    .mod-pie { grid-template-columns: 1fr; }
    .mp-s { justify-content: flex-start; text-align: left; flex-direction: row-reverse; } /* alineacion-ok: es el boton de siguiente apartado */
    .mp-cuenta { order: -1; text-align: center; }
  }
</style>
